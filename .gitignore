# Whitelist: the folder holds ~68 GB of data, checkpoints and renders; only the showcase and code are tracked.
/*
!/.gitignore
!/README.md
!/tour.ipynb
!/run.ipynb
!/neuralcello/
!/models/
!/requirements.txt
!/docs/
!/colab/
/colab/*
!/colab/cello_gan/
/colab/cello_gan/*
!/colab/cello_gan/*.py
!/colab/cello_gan/*.sh
!/colab/cello_gan/README.txt
!/v2/
/v2/*
!/v2/*.py
__pycache__/
